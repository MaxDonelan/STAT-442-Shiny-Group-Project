}
else if(rtrn$coef[i] < 0)
{
rtrn$name[i] <- "(-)" + rtrn$name[i]
}
else
{
rtrn$name[i] <- "(0)" + rtrn$name[i]
}
}
#Add +/-
#order
rtrn <- order(abs(rtrn$coef), descending = TRUE)
return(c(rtrn$name, rep(NA, length[indexes] - length(rtrn$name))))
}
