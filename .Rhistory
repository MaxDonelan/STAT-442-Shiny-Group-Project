# Run this file using Source in RStudio. Select the group's app.R when prompted.
# Adds the seasons tab locally. Does not commit, push, or install packages.
local({
# RStudio can source through wrapper frames or a temporary file. Inspect all
# frames, then use a file picker when the original bundle cannot be located.
candidates <- unlist(lapply(sys.frames(), function(frame) {
value <- get0("ofile", envir = frame, inherits = FALSE)
if (is.character(value)) value else character()
}), use.names = FALSE)
candidates <- candidates[basename(candidates) == "install_seasons.R" & file.exists(candidates)]
source_file <- if (length(candidates)) tail(candidates, 1) else NULL
if (is.null(source_file) || !file.exists(file.path(dirname(source_file), "src/ui/ui_seasons.R"))) {
message("Select install_seasons.R in the EXTRACTED seasons-tab folder first.")
source_file <- file.choose()
if (basename(source_file) != "install_seasons.R") stop("Please select install_seasons.R from the extracted ZIP.")
}
bundle <- dirname(normalizePath(source_file, mustWork = TRUE))
message("Select app.R inside your local STAT-442-Shiny-Group-Project folder.")
app_file <- normalizePath(file.choose(), mustWork = TRUE)
if (basename(app_file) != "app.R") stop("Please select the project's app.R file.")
root <- dirname(app_file)
app <- readLines(app_file, warn = FALSE)
if (any(grepl("ui_seasons.R|server_seasons.R", app))) stop("Seasons references already exist; inspect the app before installing again.")
ui_line <- grep('source("src/ui/ui_interactive_map.R", local = TRUE)$value', app, fixed = TRUE)
server_line <- grep('source("src/server/server_interactive_map.R", local = TRUE)$value', app, fixed = TRUE)
if (length(ui_line) != 1L || length(server_line) != 1L) stop("The app structure differs from the reviewed version. No files changed.")
paths <- c("src/ui/ui_seasons.R", "src/server/server_seasons.R")
if (!all(file.exists(file.path(bundle, paths)))) stop("Extract the whole ZIP before running the installer.")
if (!all(dir.exists(file.path(root, c("src/ui", "src/server"))))) stop("Expected tab folders are missing.")
if (any(file.exists(file.path(root, paths)))) stop("Season files already exist. No files changed.")
# Only insert the two source references; preserve other tabs and app settings.
app[ui_line] <- paste0('  source("src/ui/ui_interactive_map.R", local = TRUE)$value,',
'\n  source("src/ui/ui_seasons.R", local = TRUE)$value')
app[server_line] <- paste0(app[server_line], '\n  source("src/server/server_seasons.R", local = TRUE)$value')
parse(text = app)
backup <- file.path(root, "app.R.before-seasons.bak")
if (file.exists(backup)) stop("An existing seasons backup was found. No files changed.")
if (!file.copy(app_file, backup, overwrite = FALSE)) stop("Could not back up app.R.")
copied <- file.copy(file.path(bundle, paths), file.path(root, paths), overwrite = FALSE)
if (!all(copied)) stop("Some files could not be copied. app.R has not changed; check folder permissions.")
writeLines(app, app_file)
message("Installed! Open app.R in your project and click Run App. Your original app.R is backed up as app.R.before-seasons.bak. No commits or pushes were made.")
})
