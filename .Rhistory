createCoefList <- function(m, indexes, headers)
{
#Change the coef names to variable names
rtrn <- data.frame(name = names(m), coef = as.numeric(m))
print(rtrn$coef[i])
for(i in 1:length(rtrn$name))
{
if(is.na(rtrn$name[i]))
{
rm(rtrn[i,])
}
else
{
gsub("X", "", rtrn$name[i])
rtrn$name[i] <- headers[as.numeric(rtrn$name[i])]
if(rtrn$coef[i] > 0)
{
rtrn$name[i] <- "(+)" + rtrn$name[i]
}
else if(rtrn$coef[i] < 0)
{
rtrn$name[i] <- "(-)" + rtrn$name[i]
}
else
{
rtrn$name[i] <- "(0)" + rtrn$name[i]
}
}
}
#Add +/-
#order
rtrn <- order(abs(rtrn$coef), descending = TRUE)
return(c(rtrn$name, rep(NA, length[indexes] - length(rtrn$name))))
}
